<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Color de fondo -->
    <solid android:color="#FFFFFF" />

    <!-- Borde alrededor -->
    <stroke
        android:width="2dp"
        android:color="#1E88E5" />

    <!-- Tamaño opcional del padding interno -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
